{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-luna",
  "experimental": {
    "subagent_depth": 1
  },
  "providers": {
    "openrouter": {
      "settings": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.2": {
          "body": {
            "provider": {
              "order": ["streamlake"],
              "allow_fallbacks": true
            }
          }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    },
    // Detected deepseek authentication; opencode-quota added this global provider declaration.
    "deepseek": {},
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    "openai": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/openai/v1"
      }
    },
    "anthropic": {
      "settings": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/anthropic/v1"
      }
    }
  },
  "mcp": {
    "servers": {
      //   "svelte": {
      //     "type": "remote",
      //     "url": "https://mcp.svelte.dev/mcp"
      //   },
      //   "github": {
      //     "type": "remote",
      //     "url": "https://api.githubcopilot.com/mcp/",
      //     "disabled": false,
      //     "oauth": false,
      //     "headers": {
      //       "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      //     }
      //   },
      "caveman": {
        "type": "local",
        "command": ["/home/kami/.caveman/bin/caveman-mcp"],
        "disabled": false
      }
    }
  },
  "agents": {
    "title": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    },
    "general": {
      "model": "openai/gpt-6-luna",
      "request": {
        "body": { "reasoningEffort": "medium" }
      }
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "request": {
        "body": { "reasoningEffort": "low" }
      }
    },
    "scout": {
      "model": "openai/gpt-6-luna",
      "request": {
        "body": { "reasoningEffort": "low" }
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail",
    "@prevalentware/opencode-goal-plugin@0.1.55",
    "@slkiser/opencode-quota@5.0.1"
  ],
  "instructions": ["README.md", "AGENTS.md"]
}
