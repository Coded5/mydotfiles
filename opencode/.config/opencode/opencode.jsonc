{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6-luna",
  "small_model": "openrouter/deepseek/deepseek-v4-flash",
  "subagent_depth": 1,
  "provider": {
    "openrouter": {
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.2": {
          "options": {
            "provider": {
              "order": [
                "streamlake"
              ],
              "allow_fallbacks": true
            }
          }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "reasoning": true
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "reasoning": true
        }
      }
    },
    // Detected deepseek authentication; opencode-quota added this global provider declaration.
    "deepseek": {},
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {},
    "openai": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/openai/v1"
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/anthropic/v1"
      }
    }
  },
  "mcp": {
    "svelte": {
      "type": "remote",
      "url": "https://mcp.svelte.dev/mcp"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "caveman": {
      "type": "local",
      "command": [
        "/home/kami/.caveman/bin/caveman-mcp"
      ],
      "enabled": true
    }
  },
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "low"
      }
    },
    "scout": {
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "low"
      }
    }
  },
  "plugin": [
    "./.opencode/plugins/ponytail.mjs",
    "@prevalentware/opencode-goal-plugin",
    "@slkiser/opencode-quota"
  ],
  "instructions": [
    "README.md",
    "AGENTS.md"
  ],
  "server": {
    "port": 4096
  },
  "lsp": true
}
