{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "experimental": {
    "subagent_depth": 1
  },
  "providers": {
    "openrouter": {
      "settings": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.2": {
          "body": {
            "provider": {
              "order": [
                "streamlake"
              ],
              "allow_fallbacks": true
            }
          }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    },
    // Detected openai authentication; opencode-quota added this global provider declaration.
    "openai": {},
    // Detected deepseek authentication; opencode-quota added this global provider declaration.
    "deepseek": {},
    // Detected copilot authentication; opencode-quota added this global provider declaration.
    "copilot": {}
  },
  "mcp": {
    // "servers": {
    //   "svelte": {
    //     "type": "remote",
    //     "url": "https://mcp.svelte.dev/mcp"
    //   },
    //   "github": {
    //     "type": "remote",
    //     "url": "https://api.githubcopilot.com/mcp/",
    //     "disabled": false,
    //     "oauth": false,
    //     "headers": {
    //       "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
    //     }
    //   },
    //   "obsidian": {
    //     "type": "remote",
    //     "url": "http://127.0.0.1:27123/mcp/",
    //     "headers": {
    //       "Authorization": "Bearer {env:OBSIDIAN_REST_API_KEY}"
    //     }
    //   }
    // }
  },
  "agents": {
    "title": {
      "model": "openrouter/deepseek/deepseek-v4-flash"
    },
    "general": {
      "model": "openai/gpt-6-luna",
      "request": {
        "body": { "reasoningEffort": "medium" }
      }
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "request": {
        "body": { "reasoningEffort": "low" }
      }
    },
    "scout": {
      "model": "openai/gpt-6-luna",
      "request": {
        "body": { "reasoningEffort": "low" }
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail",
    "@prevalentware/opencode-goal-plugin@0.1.55",
    "@slkiser/opencode-quota@5.0.1"
  ],
  "instructions": [
    "README.md",
    "AGENTS.md"
  ]
}
