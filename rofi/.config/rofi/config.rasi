configuration {
    display-drun: "";
    display-window: "Windows";
    drun-display-format: "{icon} {name}";
    show-icons: true;
    font: "GeistMono Nerd Font Mono Medium 15";
    icon-theme: "Papirus";
    modi: "window,drun";
}

@theme "/dev/null"

* {
    background-color: transparent;
    text-color: white;
}

listview {
    border: 0;
    margin: 0;
    background-color: rgba(11, 25, 44, 0.5);
    lines: 9;
}

inputbar {
    margin: 0;
    padding: 10px;
    background-color: rgba(30, 62, 98, 0.8);
}

element {
    padding: 10px;
}

element.selected {
    background-color: rgba(15, 31, 49, 0.8);
}

element-icon {
    size: 35;
}
